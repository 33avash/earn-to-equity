# Optional: adds Gemini as a coach engine for `npm run dev` and `npm run preview`.
# The coach works without it (on-device model, rule-based answers).
# If the main model is busy, slow or out of quota, the server retries on gemini-flash-latest.
# Get a free key at https://aistudio.google.com/apikey
# Server-side only — read by the Vite dev/preview middleware in server/coach.ts.
# Never prefix with VITE_ (that would expose it to the browser bundle).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
